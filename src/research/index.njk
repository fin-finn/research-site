---
layout: layouts/base.njk
title: Research
permalink: /research/
override:tags: []
---
<h1>Research</h1>

<p>Writing and analysis. Newest first.</p>

{%- set notes = collections.research | published | reverse -%}
{%- if notes.length > 0 -%}
<ul class="post-list">
  {%- for post in notes -%}
  <li>
    <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    <p class="post-meta">{{ post.date | readableDate }}</p>
    {%- if post.data.summary %}<p>{{ post.data.summary }}</p>{% endif -%}
  </li>
  {%- endfor -%}
</ul>
{%- else -%}
<p class="empty-note">The first notes are being written and will appear here
shortly.</p>
{%- endif -%}
