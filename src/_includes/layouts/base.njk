<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% if title %}{{ title }} — {{ site.title }}{% else %}{{ site.title }}{% endif %}</title>
    {#- A note's summary describes it better than the site-wide line would. -#}
    {%- set metaDescription = description or summary or site.description -%}
    {% if metaDescription %}<meta name="description" content="{{ metaDescription }}" />{% endif %}
    <link rel="stylesheet" href="/assets/css/style.css" />
    {#- The favicon: a Palatine Parliamentary F, ink on paper. Modern browsers
        take the SVG; older ones fall back to /favicon.ico, which they request
        by themselves anyway. -#}
    <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png" />

    {#- One canonical address for every page, so the site is not treated as two
        sites when reached at www. and at the bare domain. -#}
    <link rel="canonical" href="{{ site.url }}{{ page.url }}" />

    {#- What a shared link looks like on LinkedIn, WhatsApp and the rest. Without
        these each is left to guess, and guesses badly. -#}
    <meta property="og:site_name" content="{{ site.title }}" />
    <meta property="og:title" content="{% if title %}{{ title }}{% else %}{{ site.title }}{% endif %}" />
    <meta property="og:description" content="{{ metaDescription }}" />
    <meta property="og:url" content="{{ site.url }}{{ page.url }}" />
    <meta property="og:type" content="{% if layout == 'layouts/post.njk' %}article{% else %}website{% endif %}" />
    <meta property="og:image" content="{{ site.url }}/assets/img/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="{{ site.title }} — {{ site.tagline }}" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <nav class="site-nav">
          {% for item in site.nav %}
          <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a>
          {% endfor %}
        </nav>
      </div>
    </header>

    <main class="wrap">
      {{ content | safe }}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        © {% year %} {{ site.title }}.
      </div>
    </footer>
  </body>
</html>
